{
    "targets": [
        {
            "app_name": "com.msandroid.mobile",
            "enabled": true,
            "start_up_delay_ms": 5000,
            "kernel_assisted_evasion": true,
            "injected_libraries": [
                {
                    "path": "/data/local/tmp/libsec/libsecmon.so"
                }
            ],
            "child_gating": {
                "enabled": false,
                "mode": "freeze",
                "injected_libraries": []
            },
            "remapper": {
                "enabled": true,
                "hide_library_name": "libsecond.so"
            },
            "debug_logging": true
        }
    ]
}
